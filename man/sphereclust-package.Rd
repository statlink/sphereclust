\name{sphereclust-package}
\alias{sphereclust-package}
\docType{package}
\title{
Model Based Clustering for Spherical Data Using Elliptically Symmetric Distributions
}

\description{
Model based clustering for spherical data using mixtures of spherical elliptically
symmetric projected Cauchy (SESPC) or mixtures of elliptically symmetric angular Gaussian (ESAG) distributions
}

