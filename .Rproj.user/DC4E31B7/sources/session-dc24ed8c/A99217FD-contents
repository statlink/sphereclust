bic.mixsespc <- function(x, G = 5, tol = 1e-5, ncores = 1) {
  runtime <- proc.time()
  logn <- log( dim(x)[1] )
  p <- dim(x)[2]
  bic <- icl <- numeric(G)
  
  mod <- Directional::sespc.mle(x)
  bic[1] <- icl[1] <- -2 * mod$loglik + p * logn
  
  if ( G > 1 ) {
    cl <- parallel::makeCluster(ncores)
    on.exit(parallel::stopCluster(cl))
    parallel::clusterExport(cl, varlist = c("x", "tol", "p", "logn"), envir = environment())
    parallel::clusterEvalQ(cl, library(sphereclust))
    
    results <- parallel::parSapply(cl, 2:G, function(vim) {
      a <- sphereclust::mixsespc.mle(x, vim, tol = tol)
      bic_val <- -2 * a$loglik + ( (vim - 1) + vim * p ) * logn
      icl_val <- bic_val - sum( a$probs * log(a$probs), na.rm = TRUE )
      c(bic = bic_val, icl = icl_val)
    }, simplify = TRUE )                          ## 2 x (G-1) matrix
    
    bic[2:G] <- results["bic", ]
    icl[2:G] <- results["icl", ]
  }
  
  runtime <- proc.time() - runtime
  names(bic) <- 1:G
  ina <- rep(1, G)
  ina[ which.min(bic) ] <- 3
  plot(1:G, bic, col = ina, xlab = "Number of components", ylab = "BIC values",
       cex.lab = 1.3, cex.axis = 1.3)
  abline(v = 1:G, lty = 2, col = "lightgrey")
  abline(h = seq(min(bic, na.rm = FALSE), max(bic, na.rm = FALSE), length = 10),
         lty = 2, col = "lightgrey")
  lines(1:G, bic, lwd = 2)
  points(1:G, bic, pch = 9, col = ina)
  list(bic = bic, icl = icl, runtime = runtime)
}