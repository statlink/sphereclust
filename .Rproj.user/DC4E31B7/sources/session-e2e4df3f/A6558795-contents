bic.mixesag <- function(x, G = 5, tol = 1e-5, ncores = 1) {
  runtime <- proc.time()
  logn <- log( dim(x)[1] )  ## sample size of the data
  bic <- icl <- 1:G
  mod <- Directional::esag.mle(x)
  bic[1] <- icl[1] <-  - 2 * mod$loglik + 5 * logn  ## BIC assuming one cluster

  if ( ncores > 1 ) {
    cl <- parallel::makeCluster(ncores)
    on.exit(parallel::stopCluster(cl))
    parallel::clusterExport(cl, varlist = c("x", "tol", "p", "logn"), envir = environment())
    parallel::clusterEvalQ(cl, library(sphereclust))

    results <- parallel::parSapply(cl, 2:G, function(vim) {
      a <- sphereclust::mixesag.mle(x, vim, tol = tol)
      d <- dim(a$param)[1]
      bic_val <-  -2 * a$loglik + ( d - 1 + d * 5 ) * logn
      icl_val <- bic_val - sum( a$probs * log(a$probs), na.rm = TRUE )
      c(bic = bic_val, icl = icl_val)
    }, simplify = TRUE )                          ## 2 x (G-1) matrix

    bic[2:G] <- results["bic", ]
    icl[2:G] <- results["icl", ]
  } else {

    for ( vim in 2:G ) {
      a <- sphereclust::mixesag.mle(x, vim, tol = tol)  ## model based clustering for some possible clusters
      d <- dim(a$param)[1]
      bic[vim] <-  -2 * a$loglik + ( d - 1 + d * 5 ) * logn
      icl[vim] <- bic[vim] - sum( a$probs * log(a$probs), na.rm = TRUE )
    }  ## BIC for a range of different clusters
  }

  runtime <- proc.time() - runtime
  names(bic) <- 1:G
  ina <- rep(1, G)
  ina[ which.min(bic) ] <- 3  ## chosen number of clusters will appear with red on the plot
  plot(1:G, bic, col = ina, xlab = "Number of components", ylab = "BIC values", cex.lab = 1.3, cex.axis = 1.3)
  abline(v = 1:G, lty = 2, col = "lightgrey")
  abline(h = seq(min(bic, na.rm = FALSE), max(bic, na.rm = FALSE), length = 10), lty = 2, col = "lightgrey" )
  lines(1:G, bic, lwd = 2)
  points(1:G, bic, pch = 9, col = ina)
  list(bic = bic, icl = icl, runtime = runtime)
}
